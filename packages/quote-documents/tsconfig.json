{
  "extends": "@open-harness/tsconfig/bun.json",
  "include": ["./**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strictNullChecks": true,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  }
}
