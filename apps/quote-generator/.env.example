# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quote_generator

# Better Auth
DEV_SKIP_AUTH=false
BETTER_AUTH_SECRET=replace-me-32-bytes
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001

# Microsoft SSO (Azure AD / Entra ID)
MICROSOFT_CLIENT_ID=replace-me
MICROSOFT_CLIENT_SECRET=replace-me
MICROSOFT_TENANT_ID=common
SSO_EMAIL_DOMAIN=noxe.ca

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Vercel AI Gateway (optional alternative to Anthropic)
AI_GATEWAY_API_KEY=

# Vercel Blob
DEV_LOCAL_BLOB=true
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Noxe documents API (the PDF renderer)
NOXE_DOCUMENTS_URL=http://localhost:3000
NOXE_DOCUMENTS_API_KEY=replace-me
