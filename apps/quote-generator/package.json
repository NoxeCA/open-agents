{
  "name": "quote-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --port 3000",
    "render:sample-pdf": "bun run scripts/render-sample-quote.ts",
    "db:up": "docker compose -f compose.yaml up -d db",
    "db:down": "docker compose -f compose.yaml down",
    "db:logs": "docker compose -f compose.yaml logs -f db",
    "db:migrate": "bun run lib/db/migrate.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@open-harness/quote-documents": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/react": "^3.0.170",
    "@json-render/core": "0.18.0",
    "@json-render/react": "0.18.0",
    "@json-render/react-pdf": "0.18.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/blob": "^2.3.3",
    "ai": "^6.0.168",
    "better-auth": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
